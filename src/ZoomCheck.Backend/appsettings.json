{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "DatabasePath": "data/zoomcheck.db"
  },
  "Zoom": {
    "WebhookSecretToken": "replace-with-your-zoom-webhook-secret",
    "ClientId": "replace-with-your-zoom-s2s-client-id",
    "ClientSecret": "replace-with-your-zoom-s2s-client-secret",
    "AccountId": "replace-with-your-zoom-account-id",
    "RequestTimestampToleranceSeconds": 300
  },
  "ZoomRecovery": {
    "Enabled": true,
    "StartupDelaySeconds": 3,
    "PeriodicScanIntervalSeconds": 120,
    "UsersPageSize": 100,
    "MeetingsPageSize": 300,
    "ParticipantsPageSize": 300,
    "EnableAccountWideUserDiscovery": false,
    "HostUserIds": [],
    "IncludeFallbackMeUser": true
  },
  "AllowedHosts": "*"
}
