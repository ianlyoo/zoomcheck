{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Storage": {
    "DatabasePath": "data/zoomcheck.db"
  },
  "Urls": "http://127.0.0.1:5078",
  "Dashboard": {
    "OpenBrowserOnStart": true,
    "Url": "http://127.0.0.1:5078"
  },
  "Update": {
    "Enabled": true,
    "Repository": "ianlyoo/zoomcheck",
    "ApiBaseUrl": "https://api.github.com/",
    "InstallerAssetName": "ZoomCheck-Setup-x64.exe",
    "ChecksumAssetName": "SHA256SUMS.txt",
    "AllowPrerelease": true,
    "CheckOnStartup": true,
    "StartupDelaySeconds": 10,
    "CheckIntervalHours": 12,
    "AutomaticDownload": true,
    "ShutdownAfterLaunch": true,
    "ShutdownDelaySeconds": 3
  },
  "Zoom": {
    "WebhookSecretToken": "",
    "ClientId": "",
    "ClientSecret": "",
    "AccountId": "",
    "RequestTimestampToleranceSeconds": 300
  },
  "ZoomApp": {
    "HomeUrl": "",
    "AllowedOrigins": [],
    "PairingCodeLifetimeSeconds": 600,
    "SessionOfflineSeconds": 20
  },
  "ZoomRelay": {
    "Enabled": true,
    "BaseUrl": "",
    "PollIntervalMilliseconds": 1500,
    "RequestTimeoutSeconds": 10,
    "OfflineSeconds": 20
  },
  "ZoomRecovery": {
    "Enabled": false,
    "StartupDelaySeconds": 3,
    "PeriodicScanIntervalSeconds": 120,
    "UsersPageSize": 100,
    "MeetingsPageSize": 300,
    "ParticipantsPageSize": 300,
    "MaxParticipantPages": 20,
    "EnableAccountWideUserDiscovery": false,
    "HostUserIds": [],
    "IncludeFallbackMeUser": true
  },
  "AllowedHosts": "127.0.0.1;localhost"
}
