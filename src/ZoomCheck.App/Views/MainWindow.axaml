<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ZoomCheck.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1460" d:DesignHeight="920"
        x:Class="ZoomCheck.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ZoomCheck Operator Dashboard"
        Width="1460"
        Height="920"
        MinWidth="1220"
        MinHeight="780">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" RowSpacing="20" Margin="24">
        <Border Classes="card" Padding="24">
            <Grid ColumnDefinitions="1.45*,0.95*" ColumnSpacing="24">
                <StackPanel Spacing="12">
                    <TextBlock Classes="pageEyebrow" Text="ZOOMCHECK · OPERATOR CONSOLE"/>
                    <TextBlock Classes="pageTitle" Text="{Binding HeaderTitle}"/>
                    <TextBlock Classes="pageSubtitle"
                               Text="{Binding HeaderSubtitle}"
                               TextWrapping="Wrap"
                               MaxWidth="760"/>
                </StackPanel>

                <Border Grid.Column="1" Classes="calloutPanel">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="metricLabel" Text="Session status"/>
                        <TextBlock Classes="sectionTitle" Text="{Binding ActiveSessionLabel}"/>
                        <TextBlock Classes="sectionHint"
                                   Text="{Binding StatusBanner}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.7*,1.05*" ColumnSpacing="20">
            <Grid Grid.Column="0" RowDefinitions="Auto,1.3*,0.9*" RowSpacing="20">
                <ItemsControl ItemsSource="{Binding SummaryCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryMetricViewModel">
                            <Border Classes="card" Width="320" Margin="0,0,16,16" Padding="18">
                                <StackPanel Spacing="14">
                                    <Border Width="52"
                                            Height="6"
                                            Background="{Binding AccentBrush}"
                                            CornerRadius="999"/>
                                    <TextBlock Classes="metricLabel" Text="{Binding Label}"/>
                                    <TextBlock Classes="metricValue" Text="{Binding Value}"/>
                                    <TextBlock Classes="metricDetail" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="Live participant list"/>
                                <TextBlock Classes="sectionHint"
                                           Text="Track the current meeting board here after each refresh."
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Background="{StaticResource Brush.SurfaceSecondary}"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="14,8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding LiveCoverageLabel}" Foreground="{StaticResource Brush.TextSoft}"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="2.1*,1.7*,1.2*,1*" ColumnSpacing="14">
                            <TextBlock Classes="metricLabel" Text="Roster match"/>
                            <TextBlock Classes="metricLabel" Grid.Column="1" Text="Zoom identity"/>
                            <TextBlock Classes="metricLabel" Grid.Column="2" Text="Confidence"/>
                            <TextBlock Classes="metricLabel" Grid.Column="3" Text="Timeline"/>
                        </Grid>

                        <Border Grid.Row="2"
                                Classes="calloutPanel"
                                IsVisible="{Binding ShowParticipantEmptyState}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="emptyTitle" Text="No live people yet"/>
                                <TextBlock Classes="emptyDetail"
                                           Text="Once the meeting is active and the board refreshes, participants will appear here."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding HasParticipants}">
                            <ItemsControl ItemsSource="{Binding Participants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParticipantItemViewModel">
                                        <Border Classes="listRow" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="Auto,2.1*,1.7*,1.2*,1*" ColumnSpacing="14">
                                                <Border Width="8"
                                                        Height="56"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="999"
                                                        VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RosterContext}"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="{Binding ZoomName}" FontSize="15" FontWeight="Medium"/>
                                                    <TextBlock Text="{Binding MatchContext}"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Spacing="6">
                                                    <Border Background="{StaticResource Brush.SurfaceRaised}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999"
                                                            Padding="10,5"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding ConfidenceLabel}"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ConfidenceDetail}"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" Spacing="4">
                                                    <TextBlock Text="{Binding JoinTime}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Duration}"
                                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Classes="card">
                    <Grid RowDefinitions="Auto,*" RowSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="Recent join / leave events"/>
                            <TextBlock Classes="sectionHint"
                                       Text="Watch incoming meeting activity and reconnects here."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Classes="calloutPanel"
                                IsVisible="{Binding ShowRecentEventsEmptyState}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="emptyTitle" Text="No meeting activity pulled in yet"/>
                                <TextBlock Classes="emptyDetail"
                                           Text="Recent join and leave events will appear here after the board refreshes."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding HasRecentEvents}">
                            <ItemsControl ItemsSource="{Binding RecentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivityEventViewModel">
                                        <Border Classes="listRow" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border Width="8"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="999"/>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Timestamp}"
                                                           Foreground="{StaticResource Brush.TextSoft}"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="20">
                <Border Classes="card">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="Controls and setup"/>
                            <TextBlock Classes="sectionHint"
                                       Text="Connect the meeting, load the roster, then refresh, export, or run demo events from this panel."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="10">
                            <TextBlock Classes="metricLabel" Text="Meeting ID"/>
                            <TextBox Text="{Binding MeetingId}" Watermark="Zoom meeting ID or class code"/>
                            <Button Classes="actionGhost"
                                    Content="Detect live Zoom meeting"
                                    Command="{Binding DetectLiveMeetingCommand}"/>
                            <ComboBox ItemsSource="{Binding LiveMeetings}"
                                      SelectedItem="{Binding SelectedLiveMeeting}"
                                      DisplayMemberBinding="{Binding DisplayName}"
                                      IsVisible="{Binding HasLiveMeetingCandidates}"/>
                            <TextBlock Classes="helperCopy"
                                       Text="{Binding LiveMeetingStatus}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="10">
                            <TextBlock Classes="metricLabel" Text="Roster file"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding RosterFilePath}" Watermark="Choose roster Excel file"/>
                                <Button Grid.Column="1" Classes="actionGhost" Content="Browse" Click="BrowseRosterFile_OnClick"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <Button Classes="actionSecondary" Content="Load roster" Command="{Binding LoadRosterCommand}"/>
                                <Button Grid.Column="1" Classes="actionPrimary" Content="Refresh board" Command="{Binding RefreshCommand}"/>
                                <Button Grid.Row="1" Classes="actionSecondary" Content="Export CSV" Click="Export_OnClick"/>
                                <Button Grid.Row="1" Grid.Column="1" Classes="actionGhost" Content="Demo events" Command="{Binding SeedDemoCommand}"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="3" Classes="calloutPanel">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <CheckBox IsChecked="{Binding AutoRefreshEnabled}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="metricLabel" Text="Auto refresh"/>
                                    <TextBlock Classes="helperCopy"
                                               Text="{Binding AutoRefreshStatus}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Width="86"
                                          ItemsSource="{Binding AutoRefreshIntervalOptions}"
                                          SelectedItem="{Binding SelectedAutoRefreshIntervalSeconds}"/>
                                <TextBlock Grid.Column="3" Classes="helperCopy" Text="sec" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="card">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="sectionTitle" Text="Confidence buckets"/>
                                <TextBlock Classes="sectionHint"
                                           Text="Use these counts to spot exceptions that still need operator attention."
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Background="{StaticResource Brush.SurfaceSecondary}"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding QueueStatus}" Foreground="{StaticResource Brush.TextSoft}"/>
                            </Border>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ConfidenceBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConfidenceBucketViewModel">
                                    <Border Classes="listRow" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Width="10"
                                                    Background="{Binding AccentBrush}"
                                                    CornerRadius="999"/>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Foreground="{StaticResource Brush.TextMuted}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       Foreground="{Binding AccentBrush}"
                                                       FontSize="30"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionTitle" Text="Review queue"/>
                            <TextBlock Classes="sectionHint"
                                       Text="Work the weaker matches here without leaving the operator workspace."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Classes="calloutPanel"
                                IsVisible="{Binding ShowReviewQueueEmptyState}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Classes="emptyTitle" Text="Nothing is flagged right now"/>
                                <TextBlock Classes="emptyDetail"
                                           Text="When a Zoom name needs confirmation, it will appear here for review and alias saving."
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ListBox Grid.Row="1"
                                  ItemsSource="{Binding ReviewQueue}"
                                  SelectedItem="{Binding SelectedReviewItem}"
                                  MinHeight="180"
                                  IsVisible="{Binding HasReviewQueue}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewQueueItemViewModel">
                                    <Border Classes="listRow" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Width="8" Background="{Binding AccentBrush}" CornerRadius="999"/>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{Binding ParticipantName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Suggestion}" Foreground="{StaticResource Brush.TextSoft}"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource Brush.SurfaceRaised}" BorderBrush="{Binding AccentBrush}" BorderThickness="1" CornerRadius="999" Padding="10,6" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Classes="helperCopy"
                                   Text="Select a flagged person, choose the correct roster entry, then save the alias for future refreshes."
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasReviewQueue}"/>

                        <ComboBox Grid.Row="3"
                                  ItemsSource="{Binding RosterOptions}"
                                  SelectedItem="{Binding SelectedRosterOption}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  IsVisible="{Binding HasReviewQueue}"/>

                        <TextBox Grid.Row="4"
                                 Text="{Binding SelectedAliasText}"
                                 Watermark="Alias text to save for future meetings"
                                 IsVisible="{Binding HasReviewQueue}"/>

                        <Button Grid.Row="5"
                                 Classes="actionPrimary"
                                 Content="Save alias and reclassify"
                                 Command="{Binding SaveAliasCommand}"
                                 IsEnabled="{Binding CanSaveAlias}"
                                 IsVisible="{Binding HasReviewQueue}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
